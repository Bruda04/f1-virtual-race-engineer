package rules;

import com.ftn.sbnz.f1.model.enums.FlagStatus;
import com.ftn.sbnz.f1.model.facts.BlueFlagInstructionRequired;
import com.ftn.sbnz.f1.model.facts.CheapPitStopOpportunity;
import com.ftn.sbnz.f1.model.facts.FuelCritical;
import com.ftn.sbnz.f1.model.facts.ExtremeFuelSavingStrategy;
import com.ftn.sbnz.f1.model.facts.PenaltyRisk;
import com.ftn.sbnz.f1.model.facts.RestartAttackMode;
import com.ftn.sbnz.f1.model.facts.TrackNeutralized;
import com.ftn.sbnz.f1.model.facts.TrackStatus;
import com.ftn.sbnz.f1.model.facts.TyresOldEnoughForChange;

rule "Detect neutralized track"
when
    TrackStatus(safetyCarActive == true || virtualSafetyCarActive == true)
    not TrackNeutralized()
then
    insertLogical(new TrackNeutralized());
end

rule "Use neutralized track for critical fuel saving"
when
    TrackNeutralized()
    FuelCritical()
    not ExtremeFuelSavingStrategy()
then
    insertLogical(new ExtremeFuelSavingStrategy());
end

rule "Use neutralized track for cheap pit stop"
when
    TrackNeutralized()
    TyresOldEnoughForChange()
    not CheapPitStopOpportunity()
then
    insertLogical(new CheapPitStopOpportunity());
end

rule "Detect penalty risk under yellow flag"
when
    TrackStatus(flagStatus == FlagStatus.YELLOW, driverSlowedForYellowFlag == false)
    not PenaltyRisk()
then
    insertLogical(new PenaltyRisk());
end

rule "Detect restart attack mode after safety car"
when
    TrackStatus(flagStatus == FlagStatus.GREEN, safetyCarRecentlyEnded == true)
    not RestartAttackMode()
then
    insertLogical(new RestartAttackMode());
end

rule "Detect blue flag instruction"
when
    TrackStatus(flagStatus == FlagStatus.BLUE)
    not BlueFlagInstructionRequired()
then
    insertLogical(new BlueFlagInstructionRequired());
end
