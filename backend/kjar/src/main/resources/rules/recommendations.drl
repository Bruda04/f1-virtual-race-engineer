package rules;

import com.ftn.sbnz.f1.model.enums.EngineMode;
import com.ftn.sbnz.f1.model.enums.ErsMode;
import com.ftn.sbnz.f1.model.enums.RecommendationType;
import com.ftn.sbnz.f1.model.enums.Urgency;
import com.ftn.sbnz.f1.model.facts.AttackModeBlocked;
import com.ftn.sbnz.f1.model.facts.BlueFlagInstructionRequired;
import com.ftn.sbnz.f1.model.facts.BrakeOverheating;
import com.ftn.sbnz.f1.model.facts.CheapPitStopOpportunity;
import com.ftn.sbnz.f1.model.facts.DelayPitStopRecommended;
import com.ftn.sbnz.f1.model.facts.EngineCoolingRequired;
import com.ftn.sbnz.f1.model.facts.EngineCoolingWithCleanAirInstruction;
import com.ftn.sbnz.f1.model.facts.EngineOverheating;
import com.ftn.sbnz.f1.model.facts.ErsOvertakeAvailable;
import com.ftn.sbnz.f1.model.facts.ExtremeFuelSavingStrategy;
import com.ftn.sbnz.f1.model.facts.FuelCritical;
import com.ftn.sbnz.f1.model.facts.FuelSavingDefensiveStrategy;
import com.ftn.sbnz.f1.model.facts.FullResourceDefense;
import com.ftn.sbnz.f1.model.facts.IncidentDetected;
import com.ftn.sbnz.f1.model.facts.IncreasedFailureRisk;
import com.ftn.sbnz.f1.model.facts.OvertakeOpportunity;
import com.ftn.sbnz.f1.model.facts.PenaltyRisk;
import com.ftn.sbnz.f1.model.facts.PitWindowAvailable;
import com.ftn.sbnz.f1.model.facts.PossibleSuspensionDamage;
import com.ftn.sbnz.f1.model.facts.PotentialPuncture;
import com.ftn.sbnz.f1.model.facts.RainRiskWarning;
import com.ftn.sbnz.f1.model.facts.Recommendation;
import com.ftn.sbnz.f1.model.facts.RestartAttackMode;
import com.ftn.sbnz.f1.model.facts.TyresCold;
import com.ftn.sbnz.f1.model.facts.TyresOverheated;
import com.ftn.sbnz.f1.model.facts.TyresWorn;
import com.ftn.sbnz.f1.model.facts.WeakCarPerformance;
import com.ftn.sbnz.f1.model.facts.WetEarlyPitRecommended;
import com.ftn.sbnz.f1.model.facts.PaceDropDetected;

rule "Recommend emergency pit for puncture"
    salience 100
when
    PotentialPuncture()
then
    insert(new Recommendation(
        RecommendationType.PIT_STOP,
        Urgency.CRITICAL,
        "Potential puncture detected; box immediately.",
        EngineMode.NORMAL,
        ErsMode.SAVE
    ));
end

rule "Recommend cheap safety car pit stop"
    salience 80
when
    CheapPitStopOpportunity()
not Recommendation(type == RecommendationType.PIT_STOP, urgency == Urgency.HIGH)
then
    insert(new Recommendation(
        RecommendationType.PIT_STOP,
        Urgency.HIGH,
        "Pit under Safety Car or VSC while time loss is reduced.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Recommend pit stop from pit window"
    salience 60
when
    PitWindowAvailable()
    PaceDropDetected()
    (TyresWorn() or TyresOverheated())
not Recommendation(type == RecommendationType.PIT_STOP, urgency == Urgency.HIGH)
then
    insert(new Recommendation(
        RecommendationType.PIT_STOP,
        Urgency.HIGH,
        "Pit window is available; recommend boxing.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Recommend pit for weak performance"
    salience 40
when
    WeakCarPerformance()
not Recommendation(type == RecommendationType.PIT_STOP, urgency == Urgency.HIGH)
then
    insert(new Recommendation(
        RecommendationType.PIT_STOP,
        Urgency.HIGH,
        "Tyre wear and pace drop detected; pit stop recommended.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Recommend early wet pit"
    salience 20
when
    WetEarlyPitRecommended()
then
    insert(new Recommendation(
        RecommendationType.PIT_STOP,
        Urgency.MEDIUM,
        "Rain is intensifying on a partially wet track; consider early pit.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Warn about incident"
    salience 100
when
    IncidentDetected()
then
    insert(new Recommendation(
        RecommendationType.SAFETY_ALERT,
        Urgency.CRITICAL,
        "Incident detected from g-force spike and speed drop.",
        EngineMode.NORMAL,
        ErsMode.SAVE
    ));
end

rule "Warn yellow flag penalty risk"
    salience 90
when
    PenaltyRisk()
then
    insert(new Recommendation(
        RecommendationType.SAFETY_ALERT,
        Urgency.CRITICAL,
        "Yellow flag active; slow down immediately to avoid penalty.",
        EngineMode.NORMAL,
        ErsMode.SAVE
    ));
end

rule "Warn about suspension damage"
    salience 80
when
    PossibleSuspensionDamage()
then
    insert(new Recommendation(
        RecommendationType.SAFETY_ALERT,
        Urgency.CRITICAL,
        "Possible suspension damage; avoid kerbs and report handling.",
        EngineMode.NORMAL,
        ErsMode.SAVE
    ));
end

rule "Warn about increased failure risk"
    salience 70
when
    IncreasedFailureRisk()
then
    insert(new Recommendation(
        RecommendationType.SAFETY_ALERT,
        Urgency.CRITICAL,
        "Keep current performance, but failure risk is increased.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Warn about brake overheating"
    salience 60
when
    BrakeOverheating()
not Recommendation(type == RecommendationType.SAFETY_ALERT, message == "Brake overheating detected; manage brake temperatures.")
then
    insert(new Recommendation(
        RecommendationType.SAFETY_ALERT,
        Urgency.HIGH,
        "Brake overheating detected; manage brake temperatures.",
        EngineMode.NORMAL,
        ErsMode.SAVE
    ));
end

rule "Block attack mode recommendation"
    salience 100
when
    AttackModeBlocked()
then
    insert(new Recommendation(
        RecommendationType.ENGINE_MODE,
        Urgency.HIGH,
        "Do not use attack mode until engine temperature stabilizes.",
        EngineMode.COOLING,
        ErsMode.SAVE
    ));
end

rule "Recommend engine cooling"
    salience 60
when
    EngineCoolingRequired()
then
    insert(new Recommendation(
        RecommendationType.ENGINE_MODE,
        Urgency.MEDIUM,
        "Switch to engine cooling mode.",
        EngineMode.COOLING,
        ErsMode.SAVE
    ));
end

rule "Recommend restart attack mode"
    salience 40
when
    RestartAttackMode()
then
    insert(new Recommendation(
        RecommendationType.ENGINE_MODE,
        Urgency.HIGH,
        "Green flag after neutralization; prepare for restart attack.",
        EngineMode.ATTACK,
        ErsMode.OVERTAKE
    ));
end

rule "Recommend ERS overtake"
    salience 100
when
    ErsOvertakeAvailable()
then
    insert(new Recommendation(
        RecommendationType.ERS_MODE,
        Urgency.HIGH,
        "Battery level is high; full ERS power available for overtake.",
        EngineMode.ATTACK,
        ErsMode.FULL_POWER
    ));
end

rule "Recommend blue flag compliance"
    salience 100
when
    BlueFlagInstructionRequired()
then
    insert(new Recommendation(
        RecommendationType.DRIVER_INSTRUCTION,
        Urgency.HIGH,
        "Blue flag active; yield to the lapping car.",
        EngineMode.NORMAL,
        ErsMode.SAVE
    ));
end

rule "Recommend clean air for cooling"
    salience 80
when
    EngineCoolingWithCleanAirInstruction()
then
    insert(new Recommendation(
        RecommendationType.DRIVER_INSTRUCTION,
        Urgency.HIGH,
        "Move out of dirty air to improve engine cooling.",
        EngineMode.COOLING,
        ErsMode.SAVE
    ));
end

rule "Recommend tyre warmup"
    salience 40
when
    TyresCold()
then
    insert(new Recommendation(
        RecommendationType.DRIVER_INSTRUCTION,
        Urgency.MEDIUM,
        "Increase tyre warmup maneuvers.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Recommend final lap full defense"
    salience 100
when
    FullResourceDefense()
then
    insert(new Recommendation(
        RecommendationType.STRATEGY,
        Urgency.CRITICAL,
        "Final lap defense; deploy all available resources.",
        EngineMode.DEFEND,
        ErsMode.FULL_POWER
    ));
end

rule "Recommend extreme fuel saving"
    salience 80
when
    ExtremeFuelSavingStrategy()
then
    insert(new Recommendation(
        RecommendationType.STRATEGY,
        Urgency.HIGH,
        "Activate extreme fuel-saving mode and follow the prescribed pace.",
        EngineMode.SAVE,
        ErsMode.SAVE
    ));
end

rule "Recommend fuel saving defensive strategy"
    salience 70
when
    FuelSavingDefensiveStrategy()
then
    insert(new Recommendation(
        RecommendationType.STRATEGY,
        Urgency.HIGH,
        "Defend position while saving fuel; use ERS only on straights.",
        EngineMode.SAVE,
        ErsMode.STRAIGHTS_ONLY
    ));
end

rule "Recommend delaying wet pit"
    salience 40
when
    DelayPitStopRecommended()
then
    insert(new Recommendation(
        RecommendationType.STRATEGY,
        Urgency.MEDIUM,
        "Track is wet but drying; delay pit if tyre condition allows.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Recommend DRS and overtake mode"
    salience 20
when
    OvertakeOpportunity()
then
    insert(new Recommendation(
        RecommendationType.STRATEGY,
        Urgency.MEDIUM,
        "Gap ahead is under one second; DRS and overtake mode are available.",
        EngineMode.ATTACK,
        ErsMode.NORMAL
    ));
end

rule "Warn engineer about critical fuel"
when
    FuelCritical()
then
    insert(new Recommendation(
        RecommendationType.WARNING,
        Urgency.HIGH,
        "Fuel consumption is above plan; monitor fuel target.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Warn engineer about engine overheating"
when
