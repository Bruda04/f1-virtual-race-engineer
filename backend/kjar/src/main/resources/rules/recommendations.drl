then
    insert(new Recommendation(
        RecommendationType.WARNING,
        Urgency.HIGH,
        "Engine temperature is above the safe limit.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Warn about worn tyres"
when
    TyresWorn()
then
    insert(new Recommendation(
        RecommendationType.WARNING,
        Urgency.HIGH,
        "Current tyre set is beyond the configured maximum lap count.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Warn about overheated tyres"
when
    TyresOverheated()
then
    insert(new Recommendation(
        RecommendationType.WARNING,
        Urgency.HIGH,
        "Tyres are above the critical temperature threshold.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end

rule "Warn about rain risk"
when
    RainRiskWarning()
then
    insert(new Recommendation(
        RecommendationType.WARNING,
        Urgency.MEDIUM,
        "Dry track with high rain probability; prepare reactive strategy.",
        EngineMode.NORMAL,
        ErsMode.NORMAL
    ));
end